generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Prisma uses the MySQL connector for MariaDB deployments.
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                                 String                        @id @default(uuid()) @db.VarChar(36)
  discordId                          String?                       @unique @db.VarChar(32)
  name                               String?                       @db.VarChar(120)
  email                              String?                       @unique @db.VarChar(191)
  emailVerified                      DateTime?
  image                              String?                       @db.VarChar(512)
  displayName                        String?                       @db.VarChar(120)
  callsign                           String?                       @db.VarChar(120)
  avatarUrl                          String?                       @db.VarChar(512)
  isActive                           Boolean                       @default(true)
  deletedAt                          DateTime?
  createdAt                          DateTime                      @default(now())
  updatedAt                          DateTime                      @updatedAt
  accounts                           Account[]
  sessions                           Session[]
  memberProfile                      MemberProfile?
  userRoles                          UserRole[]
  awardedRecords                     MemberQualification[]         @relation("QualificationAwardedBy")
  recordedAttendance                 AttendanceRecord[]            @relation("AttendanceRecordedBy")
  createdNotifications               Notification[]                @relation("NotificationCreatedBy")
  notificationDeliveries             NotificationDelivery[]        @relation("NotificationRecipient")
  auditEvents                        AuditLog[]                    @relation("AuditActor")
  reviewedAars                       Aar[]                         @relation("AarReviewedBy")
  createdFormTemplates               FormTemplate[]                @relation("FormTemplateCreatedBy")
  submittedForms                     FormSubmission[]              @relation("FormSubmissionSubmittedBy")
  assignedFormReviews                FormSubmission[]              @relation("FormSubmissionReviewer")
  formComments                       SubmissionComment[]           @relation("FormSubmissionCommentAuthor")
  formDecisions                      ApprovalDecision[]            @relation("ApprovalDecisionActor")
  authoredDocuments                  Document[]                    @relation("DocumentAuthor")
  ownedDocuments                     Document[]                    @relation("DocumentOwner")
  documentVersions                   DocumentVersion[]             @relation("DocumentVersionCreatedBy")
  documentAttachments                DocumentAttachment[]          @relation("DocumentAttachmentCreatedBy")
  documentReadReceipts               DocumentReadReceipt[]         @relation("DocumentReadReceiptUser")
  documentRevisionEvents             DocumentRevisionHistory[]     @relation("DocumentRevisionActor")
  uploadedDeploymentResourceVersions DeploymentResourceVersion[]   @relation("DeploymentResourceVersionUploadedBy")
  discordMemberLinks                 DiscordMemberLink[]           @relation("DiscordMemberLinkUser")
  discordGuildStates                 DiscordGuildMemberState[]     @relation("DiscordGuildMemberStateUser")
  discordSyncLogs                    DiscordSyncLog[]              @relation("DiscordSyncLogActor")
  discordModerationTargets           DiscordModerationAction[]     @relation("DiscordModerationTargetUser")
  discordModerationActions           DiscordModerationAction[]     @relation("DiscordModerationModerator")
  createdDeployments                 Campaign[]                    @relation("CampaignCreatedBy")
  zeusDeployments                    Campaign[]                    @relation("CampaignZeus")
  deploymentZeusAssignments          DeploymentZeusAssignment[]    @relation("DeploymentZeusAssignmentAssignedTo")
  changedDeploymentZeusAssignments   DeploymentZeusAssignment[]    @relation("DeploymentZeusAssignmentChangedBy")
  ledPatrolEvents                    Event[]                       @relation("EventPatrolLeader")
  submittedAars                      Aar[]                         @relation("AarSubmittedBy")
  uploadedAarAttachments             AarAttachment[]               @relation("AarAttachmentUploadedBy")
  addedPatrolParticipants            PatrolParticipant[]           @relation("PatrolParticipantAddedBy")
  patrolRsvps                        PatrolRsvp[]                  @relation("PatrolRsvpUser")
  pendingDiscordAarSubmissions       PendingDiscordAarSubmission[] @relation("PendingDiscordAarSubmittedBy")
  discordInteractionSessions         DiscordInteractionSession[]   @relation("DiscordInteractionSessionUser")
  publishedOperationsReleases        OperationsRelease[]           @relation("OperationsReleasePublishedBy")
  approvedOperationsReleases         OperationsRelease[]           @relation("OperationsReleaseApprovedBy")
}

model Account {
  id                String  @id @default(uuid()) @db.VarChar(36)
  userId            String  @db.VarChar(36)
  type              String  @db.VarChar(191)
  provider          String  @db.VarChar(191)
  providerAccountId String  @db.VarChar(191)
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String? @db.VarChar(191)
  scope             String? @db.VarChar(191)
  id_token          String? @db.Text
  session_state     String? @db.VarChar(191)
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid()) @db.VarChar(36)
  sessionToken String   @unique @db.VarChar(191)
  userId       String   @db.VarChar(36)
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String   @db.VarChar(191)
  token      String   @db.VarChar(191)
  expires    DateTime

  @@unique([identifier, token])
}

model MemberProfile {
  id                         String                      @id @default(uuid()) @db.VarChar(36)
  userId                     String?                     @unique @db.VarChar(36)
  firstName                  String?                     @db.VarChar(80)
  lastName                   String?                     @db.VarChar(80)
  displayName                String                      @db.VarChar(120)
  callsign                   String?                     @db.VarChar(120)
  joinDate                   DateTime?
  statusId                   String                      @db.VarChar(36)
  rankId                     String?                     @db.VarChar(36)
  currentUnitId              String?                     @db.VarChar(36)
  currentPositionId          String?                     @db.VarChar(36)
  isActive                   Boolean                     @default(true)
  deletedAt                  DateTime?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  user                       User?                       @relation(fields: [userId], references: [id], onDelete: SetNull)
  status                     ProfileStatus               @relation(fields: [statusId], references: [id], onDelete: Restrict)
  currentRank                Rank?                       @relation("CurrentRank", fields: [rankId], references: [id], onDelete: SetNull)
  currentUnit                Unit?                       @relation("CurrentUnit", fields: [currentUnitId], references: [id], onDelete: SetNull)
  currentPosition            Position?                   @relation("CurrentPosition", fields: [currentPositionId], references: [id], onDelete: SetNull)
  rosterAssignments          RosterAssignment[]
  qualifications             MemberQualification[]
  attendanceRecords          AttendanceRecord[]
  patrolParticipants         PatrolParticipant[]
  patrolRsvps                PatrolRsvp[]
  discordMemberLinks         DiscordMemberLink[]         @relation("DiscordMemberLinkProfile")
  discordGuildStates         DiscordGuildMemberState[]   @relation("DiscordGuildMemberStateProfile")
  discordModerationActions   DiscordModerationAction[]   @relation("DiscordModerationTargetProfile")
  discordInteractionSessions DiscordInteractionSession[] @relation("DiscordInteractionSessionProfile")

  @@index([statusId])
  @@index([rankId])
  @@index([currentUnitId])
  @@index([currentPositionId])
  @@index([displayName])
}

model ProfileStatus {
  id          String          @id @default(uuid()) @db.VarChar(36)
  key         String          @unique @db.VarChar(100)
  label       String          @db.VarChar(120)
  description String?         @db.VarChar(255)
  sortOrder   Int             @default(0)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  profiles    MemberProfile[]
}

model Rank {
  id                  String               @id @default(uuid()) @db.VarChar(36)
  key                 String               @unique @db.VarChar(100)
  label               String               @db.VarChar(120)
  abbreviation        String               @unique @db.VarChar(30)
  sortOrder           Int                  @default(0)
  isOfficer           Boolean              @default(false)
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  currentProfiles     MemberProfile[]      @relation("CurrentRank")
  rosterAssignments   RosterAssignment[]
  discordRoleMappings DiscordRoleMapping[]
}

model Unit {
  id                        String                     @id @default(uuid()) @db.VarChar(36)
  key                       String                     @unique @db.VarChar(100)
  name                      String                     @db.VarChar(120)
  shortName                 String                     @unique @db.VarChar(80)
  parentUnitId              String?                    @db.VarChar(36)
  sortOrder                 Int                        @default(0)
  isActive                  Boolean                    @default(true)
  deletedAt                 DateTime?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  parentUnit                Unit?                      @relation("UnitHierarchy", fields: [parentUnitId], references: [id], onDelete: SetNull)
  childUnits                Unit[]                     @relation("UnitHierarchy")
  currentMembers            MemberProfile[]            @relation("CurrentUnit")
  positions                 Position[]
  rosterAssignments         RosterAssignment[]
  hostedEvents              Event[]                    @relation("HostedEvents")
  qualificationRequirements QualificationRequirement[] @relation("UnitQualificationRequirements")
  documents                 Document[]
  documentPermissions       DocumentPermission[]
  discordServers            DiscordServer[]
  discordRoleMappings       DiscordRoleMapping[]
  scopedUserRoles           UserRole[]                 @relation("ScopedUnitRoles")
  notifications             Notification[]             @relation("NotificationTargetUnit")
  formTemplates             FormTemplate[]             @relation("FormTemplateTargetUnit")
  formSubmissions           FormSubmission[]           @relation("FormSubmissionTargetUnit")
  unitTaskings              UnitTasking[]              @relation("UnitTaskingUnit")

  @@index([parentUnitId])
}

model DocumentCategory {
  id          String     @id @default(uuid()) @db.VarChar(36)
  key         String     @unique @db.VarChar(100)
  label       String     @db.VarChar(120)
  description String?    @db.VarChar(255)
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  documents   Document[]

  @@index([sortOrder, label])
}

model Document {
  id                   String                    @id @default(uuid()) @db.VarChar(36)
  title                String                    @db.VarChar(191)
  slug                 String                    @unique @db.VarChar(191)
  description          String?                   @db.Text
  categoryId           String?                   @db.VarChar(36)
  status               String                    @default("draft") @db.VarChar(50)
  visibility           String                    @default("members") @db.VarChar(50)
  authorUserId         String?                   @db.VarChar(36)
  ownerUserId          String?                   @db.VarChar(36)
  unitId               String?                   @db.VarChar(36)
  currentVersionId     String?                   @db.VarChar(36)
  currentVersionNumber Int                       @default(1)
  isPinned             Boolean                   @default(false)
  publishedAt          DateTime?
  lastReviewedAt       DateTime?
  nextReviewAt         DateTime?
  archivedAt           DateTime?
  deletedAt            DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  category             DocumentCategory?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author               User?                     @relation("DocumentAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  owner                User?                     @relation("DocumentOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  unit                 Unit?                     @relation(fields: [unitId], references: [id], onDelete: SetNull)
  currentVersion       DocumentVersion?          @relation("CurrentDocumentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions             DocumentVersion[]         @relation("DocumentVersions")
  attachments          DocumentAttachment[]
  readReceipts         DocumentReadReceipt[]
  tags                 DocumentTag[]
  permissions          DocumentPermission[]
  revisionHistory      DocumentRevisionHistory[]

  @@index([categoryId, status])
  @@index([visibility, status])
  @@index([unitId, status])
  @@index([authorUserId])
  @@index([ownerUserId])
  @@index([publishedAt])
  @@index([nextReviewAt])
  @@index([archivedAt])
}

model DocumentVersion {
  id                  String                    @id @default(uuid()) @db.VarChar(36)
  documentId          String                    @db.VarChar(36)
  versionNumber       Int
  titleSnapshot       String                    @db.VarChar(191)
  descriptionSnapshot String?                   @db.Text
  body                String?                   @db.LongText
  bodyFormat          String                    @default("markdown") @db.VarChar(50)
  changeSummary       String?                   @db.VarChar(255)
  createdByUserId     String?                   @db.VarChar(36)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  document            Document                  @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)
  currentForDocuments Document[]                @relation("CurrentDocumentVersion")
  createdBy           User?                     @relation("DocumentVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  attachments         DocumentAttachment[]
  readReceipts        DocumentReadReceipt[]
  revisionHistory     DocumentRevisionHistory[]

  @@unique([documentId, versionNumber])
  @@index([documentId, createdAt])
  @@index([createdByUserId])
}

model DocumentAttachment {
  id                String           @id @default(uuid()) @db.VarChar(36)
  documentId        String           @db.VarChar(36)
  documentVersionId String?          @db.VarChar(36)
  label             String           @db.VarChar(160)
  fileName          String           @db.VarChar(191)
  mimeType          String           @db.VarChar(120)
  storageKey        String?          @db.VarChar(255)
  sourceUrl         String?          @db.VarChar(512)
  sizeBytes         Int?
  description       String?          @db.VarChar(255)
  createdByUserId   String?          @db.VarChar(36)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  document          Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentVersion   DocumentVersion? @relation(fields: [documentVersionId], references: [id], onDelete: SetNull)
  createdBy         User?            @relation("DocumentAttachmentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([documentId, createdAt])
  @@index([documentVersionId])
  @@index([createdByUserId])
}

model DocumentReadReceipt {
  id                String          @id @default(uuid()) @db.VarChar(36)
  documentId        String          @db.VarChar(36)
  documentVersionId String          @db.VarChar(36)
  userId            String          @db.VarChar(36)
  readAt            DateTime        @default(now())
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  document          Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  user              User            @relation("DocumentReadReceiptUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([documentId, documentVersionId, userId])
  @@index([userId, readAt])
}

model DocumentTag {
  id         String   @id @default(uuid()) @db.VarChar(36)
  documentId String   @db.VarChar(36)
  key        String   @db.VarChar(100)
  label      String   @db.VarChar(120)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, key])
  @@index([key])
}

model DocumentPermission {
  id            String   @id @default(uuid()) @db.VarChar(36)
  documentId    String   @db.VarChar(36)
  permissionKey String   @db.VarChar(150)
  unitId        String?  @db.VarChar(36)
  notes         String?  @db.VarChar(255)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  unit          Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@index([documentId, permissionKey])
  @@index([unitId])
}

model DocumentRevisionHistory {
  id                String           @id @default(uuid()) @db.VarChar(36)
  documentId        String           @db.VarChar(36)
  documentVersionId String?          @db.VarChar(36)
  actorUserId       String?          @db.VarChar(36)
  action            String           @db.VarChar(120)
  summary           String           @db.VarChar(255)
  oldValue          Json?
  newValue          Json?
  metadata          Json?
  reason            String?          @db.VarChar(255)
  createdAt         DateTime         @default(now())
  document          Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentVersion   DocumentVersion? @relation(fields: [documentVersionId], references: [id], onDelete: SetNull)
  actor             User?            @relation("DocumentRevisionActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([documentId, createdAt])
  @@index([documentVersionId])
  @@index([actorUserId])
  @@index([action])
}

model Position {
  id                        String                     @id @default(uuid()) @db.VarChar(36)
  key                       String                     @unique @db.VarChar(100)
  title                     String                     @db.VarChar(120)
  unitId                    String                     @db.VarChar(36)
  description               String?                    @db.VarChar(255)
  sortOrder                 Int                        @default(0)
  isLeadership              Boolean                    @default(false)
  isActive                  Boolean                    @default(true)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  unit                      Unit                       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  currentMembers            MemberProfile[]            @relation("CurrentPosition")
  rosterAssignments         RosterAssignment[]
  qualificationRequirements QualificationRequirement[] @relation("PositionQualificationRequirements")

  @@unique([unitId, title])
  @@index([unitId, sortOrder])
}

model RosterAssignment {
  id              String        @id @default(uuid()) @db.VarChar(36)
  memberProfileId String        @db.VarChar(36)
  unitId          String        @db.VarChar(36)
  positionId      String?       @db.VarChar(36)
  rankId          String?       @db.VarChar(36)
  startsAt        DateTime
  endsAt          DateTime?
  isPrimary       Boolean       @default(true)
  notes           String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  memberProfile   MemberProfile @relation(fields: [memberProfileId], references: [id], onDelete: Cascade)
  unit            Unit          @relation(fields: [unitId], references: [id], onDelete: Cascade)
  position        Position?     @relation(fields: [positionId], references: [id], onDelete: SetNull)
  rank            Rank?         @relation(fields: [rankId], references: [id], onDelete: SetNull)

  @@index([memberProfileId, startsAt])
  @@index([unitId, endsAt])
  @@index([positionId])
  @@index([rankId])
}

model QualificationCategory {
  id             String          @id @default(uuid()) @db.VarChar(36)
  key            String          @unique @db.VarChar(100)
  label          String          @db.VarChar(120)
  description    String?         @db.VarChar(255)
  sortOrder      Int             @default(0)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  qualifications Qualification[]
}

model Qualification {
  id                  String                     @id @default(uuid()) @db.VarChar(36)
  key                 String                     @unique @db.VarChar(100)
  label               String                     @db.VarChar(120)
  description         String?                    @db.VarChar(255)
  categoryId          String                     @db.VarChar(36)
  expiresAfterDays    Int?
  isActive            Boolean                    @default(true)
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  category            QualificationCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  memberRecords       MemberQualification[]
  requirements        QualificationRequirement[]
  discordRoleMappings DiscordRoleMapping[]

  @@index([categoryId, label])
}

model MemberQualification {
  id              String        @id @default(uuid()) @db.VarChar(36)
  memberProfileId String        @db.VarChar(36)
  qualificationId String        @db.VarChar(36)
  awardedByUserId String?       @db.VarChar(36)
  status          String        @default("qualified") @db.VarChar(50)
  awardedAt       DateTime      @default(now())
  expiresAt       DateTime?
  revokedAt       DateTime?
  notes           String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  memberProfile   MemberProfile @relation(fields: [memberProfileId], references: [id], onDelete: Cascade)
  qualification   Qualification @relation(fields: [qualificationId], references: [id], onDelete: Restrict)
  awardedBy       User?         @relation("QualificationAwardedBy", fields: [awardedByUserId], references: [id], onDelete: SetNull)

  @@index([memberProfileId, qualificationId])
  @@index([awardedByUserId])
  @@index([status])
}

model QualificationRequirement {
  id              String        @id @default(uuid()) @db.VarChar(36)
  qualificationId String        @db.VarChar(36)
  unitId          String?       @db.VarChar(36)
  positionId      String?       @db.VarChar(36)
  isRequired      Boolean       @default(true)
  dueWithinDays   Int?
  notes           String?       @db.VarChar(255)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  qualification   Qualification @relation(fields: [qualificationId], references: [id], onDelete: Cascade)
  unit            Unit?         @relation("UnitQualificationRequirements", fields: [unitId], references: [id], onDelete: Cascade)
  position        Position?     @relation("PositionQualificationRequirements", fields: [positionId], references: [id], onDelete: Cascade)

  @@index([qualificationId])
  @@index([unitId])
  @@index([positionId])
}

model Event {
  id                       String                        @id @default(uuid()) @db.VarChar(36)
  campaignId               String?                       @db.VarChar(36)
  hostUnitId               String?                       @db.VarChar(36)
  patrolLeaderUserId       String?                       @db.VarChar(36)
  title                    String                        @db.VarChar(160)
  description              String?                       @db.Text
  eventType                String                        @db.VarChar(80)
  status                   String                        @db.VarChar(50)
  missionStatus            String                        @default("draft") @db.VarChar(50)
  deploymentWeek           Int?
  patrolStatus             String?                       @db.VarChar(50)
  patrolType               String?                       @db.VarChar(80)
  patrolCallsign           String?                       @db.VarChar(80)
  estimatedDurationMinutes Int?
  missionMakerName         String?                       @db.VarChar(120)
  zeusName                 String?                       @db.VarChar(120)
  missionCommanderName     String?                       @db.VarChar(120)
  operationVersionLabel    String?                       @db.VarChar(120)
  selectedOperationVersion String?                       @db.VarChar(120)
  aarRequired              Boolean                       @default(false)
  aarSubmittedAt           DateTime?
  startsAt                 DateTime
  endsAt                   DateTime?
  publishedAt              DateTime?
  deletedAt                DateTime?
  createdAt                DateTime                      @default(now())
  updatedAt                DateTime                      @updatedAt
  campaign                 Campaign?                     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  hostUnit                 Unit?                         @relation("HostedEvents", fields: [hostUnitId], references: [id], onDelete: SetNull)
  patrolLeader             User?                         @relation("EventPatrolLeader", fields: [patrolLeaderUserId], references: [id], onDelete: SetNull)
  attendanceRecords        AttendanceRecord[]
  patrolParticipants       PatrolParticipant[]
  patrolRsvps              PatrolRsvp[]
  pendingDiscordAars       PendingDiscordAarSubmission[]
  conops                   Conop[]
  aars                     Aar[]
  aarAttachments           AarAttachment[]
  weeklyTasking            WeeklyTasking?
  resources                DeploymentResource[]
  operationsReleases       OperationsRelease[]

  @@index([campaignId])
  @@index([hostUnitId])
  @@index([patrolLeaderUserId])
  @@index([startsAt])
  @@index([status])
  @@index([missionStatus])
  @@index([patrolStatus])
  @@index([eventType, aarRequired])
}

model PatrolParticipant {
  id              String        @id @default(uuid()) @db.VarChar(36)
  eventId         String        @db.VarChar(36)
  memberProfileId String        @db.VarChar(36)
  addedByUserId   String?       @db.VarChar(36)
  source          String        @default("manual") @db.VarChar(50)
  notes           String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  event           Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  memberProfile   MemberProfile @relation(fields: [memberProfileId], references: [id], onDelete: Cascade)
  addedBy         User?         @relation("PatrolParticipantAddedBy", fields: [addedByUserId], references: [id], onDelete: SetNull)

  @@unique([eventId, memberProfileId])
  @@index([memberProfileId])
  @@index([addedByUserId])
}

model PatrolRsvp {
  id              String         @id @default(uuid()) @db.VarChar(36)
  eventId         String         @db.VarChar(36)
  userId          String?        @db.VarChar(36)
  memberProfileId String?        @db.VarChar(36)
  discordUserId   String?        @db.VarChar(32)
  status          String         @default("interested") @db.VarChar(50)
  source          String         @default("portal") @db.VarChar(50)
  respondedAt     DateTime       @default(now())
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  event           Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user            User?          @relation("PatrolRsvpUser", fields: [userId], references: [id], onDelete: SetNull)
  memberProfile   MemberProfile? @relation(fields: [memberProfileId], references: [id], onDelete: SetNull)

  @@index([eventId, status])
  @@index([userId])
  @@index([memberProfileId])
  @@index([discordUserId])
}

model AttendanceRecord {
  id               String        @id @default(uuid()) @db.VarChar(36)
  eventId          String        @db.VarChar(36)
  memberProfileId  String        @db.VarChar(36)
  recordedByUserId String?       @db.VarChar(36)
  rsvpStatus       String?       @db.VarChar(50)
  finalStatus      String?       @db.VarChar(50)
  respondedAt      DateTime?
  recordedAt       DateTime?
  lockedAt         DateTime?
  notes            String?       @db.Text
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
