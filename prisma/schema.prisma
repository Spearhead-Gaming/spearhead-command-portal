model CommunityCase {
  id                   String                    @id @default(uuid()) @db.VarChar(36)
  caseNumber           String                    @unique @db.VarChar(40)
  caseType             String                    @db.VarChar(80)
  title                String                    @db.VarChar(180)
  summary              String                    @db.VarChar(255)
  description          String?                   @db.Text
  status               String                    @default("open") @db.VarChar(60)
  priority             String                    @default("medium") @db.VarChar(40)
  confidentiality      String                    @default("standard") @db.VarChar(50)
  createdByUserId      String?                   @db.VarChar(36)
  assignedToUserId     String?                   @db.VarChar(36)
  owningUnitId         String?                   @db.VarChar(36)
  relatedMemberId      String?                   @db.VarChar(36)
  relatedDiscordUserId String?                   @db.VarChar(32)
  relatedEntityType    String?                   @db.VarChar(120)
  relatedEntityId      String?                   @db.VarChar(100)
  openedAt             DateTime                  @default(now())
  dueAt                DateTime?
  resolvedAt           DateTime?
  closedAt             DateTime?
  archivedAt           DateTime?
  resolution           String?                   @db.Text
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  createdBy            User?                     @relation("CommunityCaseCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  assignedTo           User?                     @relation("CommunityCaseAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  owningUnit           Unit?                     @relation("CommunityCaseOwningUnit", fields: [owningUnitId], references: [id], onDelete: SetNull)
  relatedMember        MemberProfile?            @relation("CommunityCaseRelatedMember", fields: [relatedMemberId], references: [id], onDelete: SetNull)
  assignments          CaseAssignment[]
  participants         CaseParticipant[]
  notes                CaseNote[]
  evidence             CaseEvidence[]
  decisions            CaseDecision[]
  timelineEntries      CaseTimelineEntry[]
  moderationActions    DiscordModerationAction[]
  incidentReport       IncidentReport?
  appeals              CaseAppeal[]              @relation("AppealOriginalCase")
  appealCase           CaseAppeal?               @relation("AppealCaseRecord")

  @@index([caseType, status])
  @@index([priority, status])
  @@index([confidentiality])
  @@index([assignedToUserId, status])
  @@index([owningUnitId, status])
  @@index([relatedMemberId])
  @@index([relatedDiscordUserId])
  @@index([relatedEntityType, relatedEntityId])
  @@index([dueAt])
}

