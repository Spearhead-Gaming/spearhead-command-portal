model AutomationRule {
  id            String    @id @default(uuid()) @db.VarChar(36)
  key           String    @unique @db.VarChar(120)
  name          String    @db.VarChar(160)
  description   String?   @db.Text
  triggerType   String    @db.VarChar(80)
  conditions    Json?
  actions       Json?
  isEnabled     Boolean   @default(false)
  lastRunStatus String?   @db.VarChar(50)
  lastRunAt     DateTime?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([triggerType, isEnabled])
  @@index([lastRunStatus])
}

model DashboardLayout {
  id                  String                     @id @default(uuid()) @db.VarChar(36)
  key                 String                     @unique @db.VarChar(120)
  name                String                     @db.VarChar(160)
  description         String?                    @db.Text
  dashboardType       String                     @db.VarChar(80)
  targetPermissionKey String?                    @db.VarChar(150)
  isUnitScoped        Boolean                    @default(false)
  isEnabled           Boolean                    @default(true)
  deletedAt           DateTime?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  widgets             DashboardWidgetPlacement[]

  @@index([dashboardType, isEnabled])
  @@index([targetPermissionKey])
}

model DashboardWidgetPlacement {
  id                    String          @id @default(uuid()) @db.VarChar(36)
  dashboardLayoutId     String          @db.VarChar(36)
  widgetKey             String          @db.VarChar(120)
  title                 String?         @db.VarChar(160)
  sortOrder             Int             @default(0)
  isVisible             Boolean         @default(true)
  requiredPermissionKey String?         @db.VarChar(150)
  config                Json?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  dashboardLayout       DashboardLayout @relation(fields: [dashboardLayoutId], references: [id], onDelete: Cascade)

  @@index([dashboardLayoutId, sortOrder])
  @@index([widgetKey])
}

model Notification {
  id              String                 @id @default(uuid()) @db.VarChar(36)
  createdByUserId String?                @db.VarChar(36)
  targetUnitId    String?                @db.VarChar(36)
  type            String                 @db.VarChar(80)
  urgency         String                 @default("info") @db.VarChar(32)
  title           String                 @db.VarChar(160)
  message         String                 @db.Text
  actionUrl       String?                @db.VarChar(512)
  metadata        Json?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  createdBy       User?                  @relation("NotificationCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  targetUnit      Unit?                  @relation("NotificationTargetUnit", fields: [targetUnitId], references: [id], onDelete: SetNull)
  deliveries      NotificationDelivery[]

  @@index([createdByUserId])
  @@index([targetUnitId])
  @@index([type])
  @@index([urgency])
  @@index([createdAt])
}

model NotificationDelivery {
  id                      String                 @id @default(uuid()) @db.VarChar(36)
  notificationId          String                 @db.VarChar(36)
  discordChannelMappingId String?                @db.VarChar(36)
  recipientUserId         String?                @db.VarChar(36)
  channelType             String                 @db.VarChar(50)
  destinationKey          String                 @db.VarChar(160)
  status                  String                 @db.VarChar(50)
  providerMessageId       String?                @db.VarChar(191)
  errorMessage            String?                @db.VarChar(255)
  retryCount              Int                    @default(0)
  readAt                  DateTime?
  clearedAt               DateTime?
  lastAttemptAt           DateTime?
  deliveredAt             DateTime?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  notification            Notification           @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  discordChannelMapping   DiscordChannelMapping? @relation(fields: [discordChannelMappingId], references: [id], onDelete: SetNull)
  recipientUser           User?                  @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: SetNull)

  @@index([notificationId])
  @@index([discordChannelMappingId])
  @@index([recipientUserId])
  @@index([channelType, status])
  @@index([recipientUserId, channelType, readAt])
  @@index([recipientUserId, channelType, clearedAt])
  @@index([status])
}

model DiscordServer {
  id                String                    @id @default(uuid()) @db.VarChar(36)
  unitId            String?                   @db.VarChar(36)
  guildId           String                    @unique @db.VarChar(32)
  name              String                    @db.VarChar(120)
  isPrimary         Boolean                   @default(false)
  isActive          Boolean                   @default(true)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  unit              Unit?                     @relation(fields: [unitId], references: [id], onDelete: SetNull)
  channelMappings   DiscordChannelMapping[]
  roleMappings      DiscordRoleMapping[]
  memberStates      DiscordGuildMemberState[]
  syncLogs          DiscordSyncLog[]
  moderationActions DiscordModerationAction[]

  @@index([unitId])
}

model DiscordChannelMapping {
  id                     String                 @id @default(uuid()) @db.VarChar(36)
  discordServerId        String                 @db.VarChar(36)
  key                    String                 @db.VarChar(100)
  channelId              String                 @db.VarChar(32)
  description            String?                @db.VarChar(255)
  isActive               Boolean                @default(true)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  discordServer          DiscordServer          @relation(fields: [discordServerId], references: [id], onDelete: Cascade)
  notificationDeliveries NotificationDelivery[]

  @@unique([discordServerId, key])
  @@unique([discordServerId, channelId])
  @@index([discordServerId])
}

model DiscordRoleMapping {
  id              String         @id @default(uuid()) @db.VarChar(36)
  discordServerId String         @db.VarChar(36)
  mappingType     String         @db.VarChar(50)
  discordRoleId   String         @db.VarChar(32)
  discordRoleName String?        @db.VarChar(120)
  unitId          String?        @db.VarChar(36)
  qualificationId String?        @db.VarChar(36)
  roleId          String?        @db.VarChar(36)
  rankId          String?        @db.VarChar(36)
  description     String?        @db.VarChar(255)
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  discordServer   DiscordServer  @relation(fields: [discordServerId], references: [id], onDelete: Cascade)
  unit            Unit?          @relation(fields: [unitId], references: [id], onDelete: SetNull)
  qualification   Qualification? @relation(fields: [qualificationId], references: [id], onDelete: SetNull)
  role            Role?          @relation(fields: [roleId], references: [id], onDelete: SetNull)
  rank            Rank?          @relation(fields: [rankId], references: [id], onDelete: SetNull)

  @@unique([discordServerId, discordRoleId])
  @@index([discordServerId, mappingType])
  @@index([unitId])
  @@index([qualificationId])
  @@index([roleId])
  @@index([rankId])
  @@index([isActive])
}

model DiscordMemberLink {
  id              String         @id @default(uuid()) @db.VarChar(36)
  userId          String         @db.VarChar(36)
  memberProfileId String?        @db.VarChar(36)
  discordUserId   String         @unique @db.VarChar(32)
  username        String?        @db.VarChar(120)
  displayName     String?        @db.VarChar(120)
  avatarUrl       String?        @db.VarChar(512)
  primaryGuildId  String?        @db.VarChar(32)
  firstSeenAt     DateTime       @default(now())
  lastSeenAt      DateTime       @default(now())
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  user            User           @relation("DiscordMemberLinkUser", fields: [userId], references: [id], onDelete: Cascade)
  memberProfile   MemberProfile? @relation("DiscordMemberLinkProfile", fields: [memberProfileId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([memberProfileId])
  @@index([primaryGuildId])
  @@index([lastSeenAt])
}

model DiscordGuildMemberState {
  id              String         @id @default(uuid()) @db.VarChar(36)
  discordServerId String         @db.VarChar(36)
  guildId         String         @db.VarChar(32)
  discordUserId   String         @db.VarChar(32)
  userId          String?        @db.VarChar(36)
  memberProfileId String?        @db.VarChar(36)
  username        String?        @db.VarChar(120)
  displayName     String?        @db.VarChar(120)
  avatarUrl       String?        @db.VarChar(512)
  joinedAt        DateTime?
  leftAt          DateTime?
  isBot           Boolean        @default(false)
  syncStatus      String         @default("present") @db.VarChar(50)
  lastSyncedAt    DateTime       @default(now())
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  discordServer   DiscordServer  @relation(fields: [discordServerId], references: [id], onDelete: Cascade)
  user            User?          @relation("DiscordGuildMemberStateUser", fields: [userId], references: [id], onDelete: SetNull)
  memberProfile   MemberProfile? @relation("DiscordGuildMemberStateProfile", fields: [memberProfileId], references: [id], onDelete: SetNull)

  @@unique([discordServerId, discordUserId])
  @@index([guildId])
  @@index([discordUserId])
  @@index([userId])
  @@index([memberProfileId])
  @@index([syncStatus])
  @@index([lastSyncedAt])
}

model DiscordSyncLog {
  id              String         @id @default(uuid()) @db.VarChar(36)
  discordServerId String?        @db.VarChar(36)
  actorUserId     String?        @db.VarChar(36)
  syncType        String         @db.VarChar(50)
  status          String         @db.VarChar(50)
  scannedCount    Int            @default(0)
  importedCount   Int            @default(0)
  updatedCount    Int            @default(0)
  leftCount       Int            @default(0)
  skippedBotCount Int            @default(0)
  errorMessage    String?        @db.VarChar(255)
  metadata        Json?
  startedAt       DateTime       @default(now())
  completedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  discordServer   DiscordServer? @relation(fields: [discordServerId], references: [id], onDelete: SetNull)
  actor           User?          @relation("DiscordSyncLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([discordServerId])
  @@index([actorUserId])
  @@index([syncType, status])
  @@index([startedAt])
}

model DiscordInteractionSession {
  id                String         @id @default(uuid()) @db.VarChar(36)
  discordUserId     String         @db.VarChar(32)
  portalUserId      String?        @db.VarChar(36)
  memberProfileId   String?        @db.VarChar(36)
  guildId           String?        @db.VarChar(32)
  channelId         String?        @db.VarChar(32)
  commandName       String         @db.VarChar(100)
  workflowType      String         @db.VarChar(80)
  currentStep       String         @db.VarChar(100)
  status            String         @default("ACTIVE") @db.VarChar(40)
  temporaryPayload  Json?
  relatedEntityType String?        @db.VarChar(120)
  relatedEntityId   String?        @db.VarChar(100)
  expiresAt         DateTime
  completedAt       DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  portalUser        User?          @relation("DiscordInteractionSessionUser", fields: [portalUserId], references: [id], onDelete: SetNull)
  memberProfile     MemberProfile? @relation("DiscordInteractionSessionProfile", fields: [memberProfileId], references: [id], onDelete: SetNull)

  @@index([discordUserId, status, workflowType])
  @@index([portalUserId, status])
  @@index([memberProfileId])
  @@index([guildId, channelId])
  @@index([status, expiresAt])
  @@index([relatedEntityType, relatedEntityId])
}

model DiscordModerationAction {
  id                    String         @id @default(uuid()) @db.VarChar(36)
  discordServerId       String         @db.VarChar(36)
  moderatorUserId       String?        @db.VarChar(36)
  targetUserId          String?        @db.VarChar(36)
  targetMemberProfileId String?        @db.VarChar(36)
  targetDiscordUserId   String         @db.VarChar(32)
  action                String         @db.VarChar(50)
  reason                String         @db.VarChar(255)
  result                String         @db.VarChar(50)
  errorMessage          String?        @db.VarChar(255)
  providerActionId      String?        @db.VarChar(191)
  metadata              Json?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  discordServer         DiscordServer  @relation(fields: [discordServerId], references: [id], onDelete: Cascade)
  moderator             User?          @relation("DiscordModerationModerator", fields: [moderatorUserId], references: [id], onDelete: SetNull)
  targetUser            User?          @relation("DiscordModerationTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  targetMemberProfile   MemberProfile? @relation("DiscordModerationTargetProfile", fields: [targetMemberProfileId], references: [id], onDelete: SetNull)

  @@index([discordServerId])
  @@index([moderatorUserId])
  @@index([targetUserId])
  @@index([targetMemberProfileId])
  @@index([targetDiscordUserId])
  @@index([action, result])
  @@index([createdAt])
}

model Permission {
  id              String           @id @default(uuid()) @db.VarChar(36)
  key             String           @unique @db.VarChar(150)
  label           String           @db.VarChar(120)
  description     String?          @db.VarChar(255)
  module          String           @db.VarChar(50)
  category        String           @db.VarChar(80)
  isSystem        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]

  @@index([module, category])
}

model Role {
  id                  String               @id @default(uuid()) @db.VarChar(36)
  name                String               @unique @db.VarChar(100)
  label               String               @db.VarChar(120)
  description         String?              @db.VarChar(255)
  isSystem            Boolean              @default(false)
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  rolePermissions     RolePermission[]
  userRoles           UserRole[]
  approvalSteps       ApprovalStep[]       @relation("ApprovalStepTargetRole")
  discordRoleMappings DiscordRoleMapping[]
}

model RolePermission {
  id           String     @id @default(uuid()) @db.VarChar(36)
  roleId       String     @db.VarChar(36)
  permissionId String     @db.VarChar(36)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model UserRole {
  id        String    @id @default(uuid()) @db.VarChar(36)
  userId    String    @db.VarChar(36)
  roleId    String    @db.VarChar(36)
  unitId    String?   @db.VarChar(36)
  startsAt  DateTime?
  endsAt    DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  unit      Unit?     @relation("ScopedUnitRoles", fields: [unitId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([roleId])
  @@index([unitId])
  @@index([startsAt, endsAt, isActive])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.VarChar(36)
  actorUserId String?  @db.VarChar(36)
  action      String   @db.VarChar(120)
  entityType  String   @db.VarChar(120)
  entityId    String?  @db.VarChar(100)
  summary     String   @db.VarChar(255)
  oldValue    Json?
  newValue    Json?
  metadata    Json?
  reason      String?  @db.VarChar(255)
  ipAddress   String?  @db.VarChar(64)
  createdAt   DateTime @default(now())
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}
