APP_ENV="development"
NODE_ENV="development"

# Prisma uses the MySQL connector for MariaDB deployments.
DATABASE_URL="mysql://root:password@localhost:3306/spearhead_command_portal"

AUTH_SECRET="replace-with-a-local-32-character-random-secret"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="false"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Spearhead Command Portal"

FILE_STORAGE_ROOT="./storage"

DISCORD_CLIENT_ID="your-local-discord-oauth-client-id"
DISCORD_CLIENT_SECRET="your-local-discord-oauth-client-secret"
DISCORD_BOT_TOKEN="your-local-discord-bot-token"
DISCORD_PUBLIC_KEY="your-local-discord-public-key"
DISCORD_APPLICATION_ID="your-local-discord-application-id"
DISCORD_REGISTER_MODE="guild"
DISCORD_DEV_GUILD_ID="your-local-test-guild-id"
DISCORD_INTERACTIONS_URL="https://your-local-tunnel.example.com/api/discord/interactions"

DISCORD_INTERACTION_SESSION_TTL_MINUTES="15"
DISCORD_MEMBER_SYNC_DEFAULT_STATUS_KEY="recruit"
SYNC_DISCORD_BOTS="false"

DISCORD_GATEWAY_ENABLED="false"
DISCORD_GATEWAY_INTENTS="Guilds,GuildMembers,GuildVoiceStates"
DISCORD_GATEWAY_SHARD_COUNT="1"
DISCORD_PRIMARY_GUILD_ID=""
DISCORD_GATEWAY_HEARTBEAT_TIMEOUT="45000"
DISCORD_GATEWAY_RECONNECT_MAX_DELAY="30000"
DISCORD_GATEWAY_EVENT_LOG_LEVEL="summary"

ENABLE_DEV_LOGIN="false"
DEV_LOGIN_SECRET=""
DEV_LOGIN_EMAIL="owner@example.com"

APP_VERSION="local"
