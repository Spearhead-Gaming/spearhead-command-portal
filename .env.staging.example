APP_ENV="staging"
NODE_ENV="production"

# Use the Docker Compose service hostname when using the bundled MariaDB service.
DATABASE_URL="mysql://spearhead:replace-with-staging-db-password@db:3306/spearhead_command_portal"
MARIADB_DATABASE="spearhead_command_portal"
MARIADB_USER="spearhead"
MARIADB_PASSWORD="replace-with-staging-db-password"
MARIADB_ROOT_PASSWORD="replace-with-staging-root-password"

AUTH_SECRET="replace-with-staging-32-character-random-secret"
AUTH_URL="https://staging.example.com"
AUTH_TRUST_HOST="true"
NEXT_PUBLIC_APP_URL="https://staging.example.com"
NEXT_PUBLIC_APP_NAME="Spearhead Command Portal"

FILE_STORAGE_ROOT="/app/storage"

DISCORD_CLIENT_ID="replace-with-staging-discord-client-id"
DISCORD_CLIENT_SECRET="replace-with-staging-discord-client-secret"
DISCORD_BOT_TOKEN="replace-with-staging-discord-bot-token"
DISCORD_PUBLIC_KEY="replace-with-staging-discord-public-key"
DISCORD_APPLICATION_ID="replace-with-staging-discord-application-id"
DISCORD_REGISTER_MODE="guild"
DISCORD_DEV_GUILD_ID="replace-with-staging-guild-id"
DISCORD_INTERACTIONS_URL="https://staging.example.com/api/discord/interactions"

DISCORD_INTERACTION_SESSION_TTL_MINUTES="15"
DISCORD_MEMBER_SYNC_DEFAULT_STATUS_KEY="recruit"
SYNC_DISCORD_BOTS="false"

DISCORD_GATEWAY_ENABLED="false"
DISCORD_GATEWAY_INTENTS="Guilds,GuildMembers,GuildVoiceStates"
DISCORD_GATEWAY_SHARD_COUNT="1"
DISCORD_PRIMARY_GUILD_ID=""
DISCORD_GATEWAY_HEARTBEAT_TIMEOUT="45000"
DISCORD_GATEWAY_RECONNECT_MAX_DELAY="30000"
DISCORD_GATEWAY_EVENT_LOG_LEVEL="summary"

ENABLE_DEV_LOGIN="false"
DEV_LOGIN_SECRET=""
DEV_LOGIN_EMAIL="owner@example.com"

APP_VERSION="staging"
WEB_BIND="127.0.0.1"
WEB_PORT="3000"
